generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("COACH")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  athletes      Athlete[]
  trainingPlans TrainingPlan[]
}

model Athlete {
  id            String         @id @default(cuid())
  coachId       String
  coach         User           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  sport         String
  position      String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  trainingPlans TrainingPlan[]
  progressMetrics ProgressMetric[]
  progressGoals   ProgressGoal[]
  shareLinks      ParentShareLink[]

  @@index([coachId])
}

model ProgressGoal {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  label       String
  targetValue Float
  unit        String
  direction   String    @default("HIGHER")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([athleteId])
}

model ParentShareLink {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  token       String    @unique
  label       String?
  parentEmail String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([athleteId])
  @@index([token])
}

model ProgressMetric {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  label      String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([athleteId])
  @@index([athleteId, label])
}

model TrainingPlan {
  id          String    @id @default(cuid())
  coachId     String
  coach       User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId   String?
  athlete     Athlete?  @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]

  @@index([coachId])
  @@index([athleteId])
}

model Workout {
  id              String       @id @default(cuid())
  trainingPlanId  String
  trainingPlan    TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  scheduledDate   DateTime?
  durationMinutes Int?
  completed       Boolean      @default(false)
  completedAt     DateTime?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([trainingPlanId])
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  ORG_ADMIN
  COACH
  TRAINER
  STAFF
  PARENT
  ATHLETE
}

enum OrgRole {
  OWNER
  ADMIN
  COACH
  STAFF
}

enum MetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum MetricSource {
  SELF_REPORTED
  COACH_ENTERED
  TEST_EVENT
  DEVICE
  VERIFIED
}

enum ProfileVisibility {
  PRIVATE
  AUTHENTICATED
  ORGANIZATION
  PUBLIC
}

enum VerificationType {
  SELF_REPORTED
  COACH
  TRAIN2PLAY
}

enum ResultStatus {
  ACTIVE
  FLAGGED
  INVALIDATED
  HIDDEN
}

enum HomepageModuleKind {
  PLAYER_OF_THE_WEEK
  TOP_PERFORMANCE
  MOST_IMPROVED
  TRAINING_LEADER
  CURRENT_CHALLENGE
  CUSTOM
}

enum ChallengeScoringType {
  WORKOUT_COUNT
  TRAINING_DAYS
  PROGRAM_COMPLETION
  SPECIFIC_WORKOUT
  SPECIFIC_DRILL
  PR_ACHIEVEMENT
  METRIC_IMPROVEMENT
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RankingType {
  METRIC
  MOST_IMPROVED
  TRAINING_DAYS
  WORKOUTS_COMPLETED
  PROGRAM_COMPLETION
  CONSISTENCY
}

model Organization {
  id                  String                    @id @default(cuid())
  name                String
  slug                String                    @unique
  logoUrl             String?
  primaryColor        String?
  isActive            Boolean                   @default(true)
  deactivatedAt       DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  memberships         OrganizationMembership[]
  teams               Team[]
  athleteMemberships  AthleteMembership[]
  directorAssignments DirectorSportAssignment[]

  @@index([isActive])
}

/**
 * Sports enabled across Train2Play. Existing sport strings remain compatible.
 */
model PlatformSport {
  id                  String                    @id @default(cuid())
  name                String                    @unique
  slug                String                    @unique
  isActive            Boolean                   @default(true)
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  directorAssignments DirectorSportAssignment[]

  @@index([isActive, sortOrder])
}

/**
 * A Director may operate one or more sports, optionally scoped to an organization.
 */
model DirectorSportAssignment {
  id             String        @id @default(cuid())
  directorUserId String
  directorUser   User          @relation("DirectorSportAssignments", fields: [directorUserId], references: [id], onDelete: Cascade)
  sportId        String
  sport          PlatformSport @relation(fields: [sportId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedBy     User?         @relation("DirectorAssignmentsMade", fields: [assignedById], references: [id], onDelete: SetNull)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([directorUserId, sportId, organizationId])
  @@index([directorUserId, isActive])
  @@index([sportId, isActive])
  @@index([organizationId, isActive])
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(COACH)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Team {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  sport              String
  season             String?
  createdAt          DateTime            @default(now())
  athleteMemberships AthleteMembership[]

  @@index([organizationId])
}

model AthleteProfile {
  id                        String                         @id @default(cuid())
  userId                    String?                        @unique
  user                      User?                          @relation("AthleteProfileUser", fields: [userId], references: [id], onDelete: SetNull)
  firstName                 String
  lastName                  String
  dateOfBirth               DateTime?
  graduationYear            Int?
  avatarUrl                 String?
  primarySport              String?
  displayName               String?
  publicSlug                String?                        @unique
  bio                       String?
  coverImageUrl             String?
  locationState             String?
  instagramHandle           String?
  instagramUrl              String?
  instagramPublic           Boolean                        @default(false)
  xHandle                   String?
  xUrl                      String?
  xPublic                   Boolean                        @default(false)
  tiktokHandle              String?
  tiktokUrl                 String?
  tiktokPublic              Boolean                        @default(false)
  youtubeHandle             String?
  youtubeUrl                String?
  youtubePublic             Boolean                        @default(false)
  profileVisibility         ProfileVisibility              @default(PRIVATE)
  featuredVideoReviewId     String?
  featuredVideoReview       VideoReview?                   @relation("AthleteFeaturedVideo", fields: [featuredVideoReviewId], references: [id], onDelete: SetNull)
  featuredMetricIds         String[]                       @default([])
  recruitingStatus          String?
  collegeInterest           String?
  academicNotes             String?
  awardsNotes               String?
  contactPreference         String?
  slugUpdatedAt             DateTime?
  legacyAthleteId           String?                        @unique
  legacyAthlete             Athlete?                       @relation("LegacyAthleteProfile", fields: [legacyAthleteId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  sports                    AthleteSport[]
  memberships               AthleteMembership[]
  guardianLinks             GuardianLink[]
  metricEntries             MetricEntry[]
  coachConnections          CoachAthleteConnection[]
  videoReviews              VideoReview[]
  courseItemProgress        CourseItemProgress[]
  catalogDrillRecipients    CatalogDrillAthleteRecipient[]
  catalogDrillPushes        CatalogDrillPush[]
  guardianContacts          GuardianContact[]
  consentRecords            ConsentRecord[]
  publicVideoSharingEnabled Boolean                        @default(false)
  publicLeaderboardOptIn    Boolean                        @default(false)
  privacySettingsUpdatedAt  DateTime?
  showcaseVideos            AthleteProfileVideoShowcase[]
  achievements              AthleteAchievement[]
  playerOfTheWeekWins       PlayerOfTheWeek[]
  challengeEntries          ChallengeEntry[]
  competitionStats          CompetitionStat[]
  contentSubmissions        AthleteContentSubmission[]

  @@index([legacyAthleteId])
  @@index([profileVisibility])
  @@index([locationState])
  @@index([primarySport])
}

model AthleteSport {
  id                String         @id @default(cuid())
  athleteProfileId  String
  athleteProfile    AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  sport             String
  position          String?
  secondaryPosition String?
  isPrimary         Boolean        @default(false)

  @@unique([athleteProfileId, sport])
}

model AthleteMembership {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  coachUserId      String?
  coachUser        User?          @relation("AthleteMembershipCoach", fields: [coachUserId], references: [id], onDelete: SetNull)
  startsAt         DateTime       @default(now())
  endsAt           DateTime?

  @@index([athleteProfileId])
  @@index([organizationId])
  @@index([coachUserId])
}

model GuardianLink {
  id               String         @id @default(cuid())
  guardianUserId   String
  guardianUser     User           @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: Cascade)
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  relationship     String
  consentGivenAt   DateTime?
  canViewProgress  Boolean        @default(true)
  canManageAccount Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@unique([guardianUserId, athleteProfileId])
  @@index([athleteProfileId])
}

/**
 * Parent or legal-guardian contact supplied for an athlete. This does not
 * create login access; GuardianLink remains the authorization relationship.
 */
model GuardianContact {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  relationship     String
  email            String
  phone            String?
  isPrimary        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([athleteProfileId])
  @@index([email])
}

/**
 * Append-only evidence of the choices made during signup. Public sharing
 * choices are independent and default to denied.
 */
model ConsentRecord {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  grantedByUserId  String?
  grantedByUser    User?          @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  consentType      String
  granted          Boolean
  documentVersion  String
  guardianName     String?
  guardianEmail    String?
  createdAt        DateTime       @default(now())

  @@index([athleteProfileId, consentType, createdAt])
  @@index([grantedByUserId])
}

/**
 * Many-to-many coach ↔ athlete development relationship.
 * Athlete.coachId remains roster-originator for legacy training rows;
 * authorization for connected coaches uses APPROVED rows here (+ AthleteMembership).
 */
model CoachAthleteConnection {
  id                       String         @id @default(cuid())
  coachUserId              String
  coachUser                User           @relation("CoachConnectionCoach", fields: [coachUserId], references: [id], onDelete: Cascade)
  athleteProfileId         String
  athleteProfile           AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  /**
   * PENDING | PENDING_GUARDIAN | PENDING_COACH | APPROVED | DECLINED | CANCELLED | REVOKED | EXPIRED
   * Coach-code requests still use PENDING. Discovery uses PENDING_GUARDIAN then PENDING_COACH.
   */
  status                   String         @default("PENDING")
  /**
   * EMAIL_INVITE | COACH_CODE | QR_CODE | ORGANIZATION | ADMIN | DISCOVERY
   */
  source                   String         @default("COACH_CODE")
  requestedAt              DateTime       @default(now())
  approvedAt               DateTime?
  declinedAt               DateTime?
  cancelledAt              DateTime?
  expiredAt                DateTime?
  athleteNote              String?
  requestedSpecialty       String?
  coachDeclineNote         String?
  /**
   * Required for minors on Find a Coach discovery requests. Coach cannot accept until set.
   */
  guardianApprovalRequired Boolean        @default(false)
  guardianApprovedAt       DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([coachUserId, status])
  @@index([athleteProfileId, status])
  @@index([coachUserId, athleteProfileId])
}

model MetricDefinition {
  id                        String            @id @default(cuid())
  sport                     String
  slug                      String
  name                      String
  category                  String
  unit                      String
  direction                 MetricDirection
  inputType                 String            @default("number")
  isActive                  Boolean           @default(true)
  leaderboardEligible       Boolean           @default(false)
  publicLeaderboardEligible Boolean           @default(false)
  verificationRequirement   String            @default("NONE")
  isSensitive               Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  entries                   MetricEntry[]
  workoutExercises          WorkoutExercise[]

  @@unique([sport, slug])
  @@index([sport, isActive])
}

model MetricEntry {
  id                 String            @id @default(cuid())
  athleteProfileId   String
  athleteProfile     AthleteProfile    @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  metricDefinitionId String
  metricDefinition   MetricDefinition  @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  value              Float
  recordedAt         DateTime          @default(now())
  source             MetricSource      @default(COACH_ENTERED)
  verifiedAt         DateTime?
  verifiedByUserId   String?
  verifiedByUser     User?             @relation("MetricEntryVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationType   VerificationType  @default(SELF_REPORTED)
  resultStatus       ResultStatus      @default(ACTIVE)
  resultSource       String?
  flaggedAt          DateTime?
  flaggedReason      String?
  enteredByUserId    String?
  enteredByUser      User?             @relation("MetricEntryEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  notes              String?
  legacyMetricId     String?           @unique
  legacyMetric       ProgressMetric?   @relation("LegacyMetricEntry", fields: [legacyMetricId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  exerciseResult     ExerciseResult?
  videoReviews       VideoReview[]
  contentSubmissions AthleteContentSubmission[]

  @@index([athleteProfileId])
  @@index([metricDefinitionId])
  @@index([athleteProfileId, recordedAt])
  @@index([resultStatus, recordedAt])
  @@index([verificationType, resultStatus])
  @@index([metricDefinitionId, resultStatus, recordedAt])
}

model User {
  id                          String                    @id @default(cuid())
  name                        String
  email                       String                    @unique
  passwordHash                String
  role                        UserRole                  @default(COACH)
  zipCode                     String?
  latitude                    Float?
  longitude                   Float?
  searchRadiusMiles           Int                       @default(25)
  pickupAlertsEnabled         Boolean                   @default(true)
  lookingForSport             String?
  lookingForPositions         String?
  minThrowingVelo             Float?
  onboardingCompletedAt       DateTime?
  isActive                    Boolean                   @default(true)
  deactivatedAt               DateTime?
  lastActiveAt                DateTime?
  sessionVersion              Int                       @default(0)
  /**
   * Human-readable coach connection code (e.g. LESTER4821). Not a login secret.
   */
  connectionCode              String?                   @unique
  connectionCodeCreatedAt     DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  athletes                    Athlete[]
  trainingPlans               TrainingPlan[]
  trainingVideos              TrainingVideo[]
  courses                     Course[]
  pickupInterests             PickupInterest[]
  passwordResetTokens         PasswordResetToken[]
  organizationMemberships     OrganizationMembership[]
  athleteProfile              AthleteProfile?           @relation("AthleteProfileUser")
  coachedAthleteMemberships   AthleteMembership[]       @relation("AthleteMembershipCoach")
  guardianLinks               GuardianLink[]            @relation("GuardianUser")
  metricEntriesEntered        MetricEntry[]             @relation("MetricEntryEnteredBy")
  metricEntriesVerified       MetricEntry[]             @relation("MetricEntryVerifiedBy")
  athleteInvitesSent          AthleteInvite[]           @relation("AthleteInviteSender")
  workoutSessions             WorkoutSession[]          @relation("WorkoutSessionAthleteUser")
  coachConnections            CoachAthleteConnection[]  @relation("CoachConnectionCoach")
  catalogDrillPushes          CatalogDrillPush[]        @relation("CatalogDrillPushSender")
  directorSportAssignments    DirectorSportAssignment[] @relation("DirectorSportAssignments")
  directorAssignmentsMade     DirectorSportAssignment[] @relation("DirectorAssignmentsMade")
  adminAuditActions           AdminAuditLog[]           @relation("AdminAuditActor")
  videoReviewsAsCoach         VideoReview[]             @relation("VideoReviewCoach")
  videoReviewsUploaded        VideoReview[]             @relation("VideoReviewUploadedBy")
  voiceReviewsRecorded        VoiceReview[]             @relation("VoiceReviewCoach")
  notifications               AppNotification[]
  videoReviewTrainingAssigned VideoReviewTrainingLink[] @relation("VideoReviewTrainingAssignedBy")
  mediaUploads                MediaUpload[]
  consentRecords              ConsentRecord[]           @relation("ConsentGrantedBy")
  playerOfTheWeekCreated      PlayerOfTheWeek[]         @relation("PlayerOfTheWeekCreatedBy")
  challengesCreated           Challenge[]               @relation("ChallengeCreatedBy")
  homepageWeeksCreated        HomepageWeek[]            @relation("HomepageWeekCreatedBy")
  contentSubmissionsReviewed  AthleteContentSubmission[] @relation("ContentSubmissionReviewedBy")
  coachProfile                CoachProfile?              @relation("CoachProfileUser")
  coachProfilesReviewed       CoachProfile[]             @relation("CoachProfileReviewedBy")

  @@index([role, isActive])
  @@index([createdAt])
  @@index([lastActiveAt])
}

/**
 * A private, direct-to-R2 multipart video. The browser uploads chunks straight
 * to R2; application records reference /api/media/videos/{id}, never a public
 * bucket URL. Associations are resolved from those URLs for playback auth.
 */
model MediaUpload {
  id           String    @id @default(cuid())
  ownerUserId  String
  ownerUser    User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  provider     String    @default("s3")
  storageKey   String    @unique
  multipartId  String?
  originalName String
  contentType  String
  sizeBytes    BigInt
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  expiresAt    DateTime

  @@index([ownerUserId, status])
  @@index([status, expiresAt])
}

/**
 * Immutable audit trail for material Platform Admin changes.
 */
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  actorUser    User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action       String
  entityType   String
  entityId     String
  summary      String
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Athlete {
  id                String            @id @default(cuid())
  coachId           String
  coach             User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  sport             String
  position          String?
  notes             String?
  rosterStatus      String            @default("ROSTER")
  throws            String?
  bats              String?
  zipCode           String?
  latitude          Float?
  longitude         Float?
  pickupType        String?
  availabilityNotes String?
  listedForPickup   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  trainingPlans     TrainingPlan[]
  progressMetrics   ProgressMetric[]
  progressGoals     ProgressGoal[]
  shareLinks        ParentShareLink[]
  trainingVideos    TrainingVideo[]
  pickupInterests   PickupInterest[]
  athleteProfile    AthleteProfile?   @relation("LegacyAthleteProfile")
  athleteInvites    AthleteInvite[]
  workoutSessions   WorkoutSession[]

  @@index([coachId])
  @@index([rosterStatus, listedForPickup])
}

model PickupInterest {
  id                String   @id @default(cuid())
  interestedCoachId String
  interestedCoach   User     @relation(fields: [interestedCoachId], references: [id], onDelete: Cascade)
  pickupAthleteId   String
  pickupAthlete     Athlete  @relation(fields: [pickupAthleteId], references: [id], onDelete: Cascade)
  message           String?
  createdAt         DateTime @default(now())

  @@unique([interestedCoachId, pickupAthleteId])
  @@index([pickupAthleteId])
}

model TrainingVideo {
  id           String            @id @default(cuid())
  coachId      String
  coach        User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId    String?
  athlete      Athlete?          @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  sourceType   String            @default("URL")
  videoUrl     String
  /**
   * Object-storage key when uploaded (Cloudinary/S3); not used for URL pastes
   */
  storageKey   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  annotations  VideoAnnotation[]
  videoReviews VideoReview[]
  featuredOnCoachProfiles CoachProfile[]     @relation("CoachFeaturedVideo")
  coachProfileVideos      CoachProfileVideo[]

  @@index([coachId])
  @@index([athleteId])
}

model VideoAnnotation {
  id          String        @id @default(cuid())
  videoId     String
  video       TrainingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  timestampMs Int
  label       String?
  note        String?
  strokes     String
  createdAt   DateTime      @default(now())

  @@index([videoId])
  @@index([videoId, timestampMs])
}

/**
 * Athlete-submitted film for a connected coach to review.
 * Reuses TrainingVideo for storage + VideoAnnotation for drawings.
 */
model VideoReview {
  id                 String                    @id @default(cuid())
  trainingVideoId    String
  trainingVideo      TrainingVideo             @relation(fields: [trainingVideoId], references: [id], onDelete: Cascade)
  athleteProfileId   String
  athleteProfile     AthleteProfile            @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  coachUserId        String
  coachUser          User                      @relation("VideoReviewCoach", fields: [coachUserId], references: [id], onDelete: Cascade)
  uploadedByUserId   String
  uploadedByUser     User                      @relation("VideoReviewUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  title              String
  sport              String
  category           String
  athleteNote        String?
  coachFeedback      String?
  /**
   * AWAITING_REVIEW | IN_REVIEW | REVIEWED | LIBRARY | ARCHIVED
   * LIBRARY = athlete profile/showcase clip, not sitting in a coach review queue.
   * ARCHIVED = removed from the Player Profile showcase; coaching reviews stay REVIEWED.
   */
  status             String                    @default("AWAITING_REVIEW")
  /**
   * REVIEW = sent to a coach. LIBRARY = same TrainingVideo/VideoReview record, profile-owned.
   */
  purpose            String                    @default("REVIEW")
  /**
   * PRIVATE | COACHES | TRAIN2PLAY | PUBLIC_PROFILE
   * Public Player Profile still also requires publicVideoSharingEnabled + featured/highlight selection.
   */
  showcaseVisibility String                    @default("PRIVATE")
  metricEntryId      String?
  metricEntry        MetricEntry?              @relation(fields: [metricEntryId], references: [id], onDelete: SetNull)
  achievementId      String?
  achievement        AthleteAchievement?       @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  submittedAt        DateTime                  @default(now())
  reviewedAt         DateTime?
  /**
   * Future: AI observations JSON — not used yet
   */
  aiObservationsJson String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  trainingLinks      VideoReviewTrainingLink[]
  voiceReview        VoiceReview?
  featuredOnProfiles AthleteProfile[]              @relation("AthleteFeaturedVideo")
  showcaseItems      AthleteProfileVideoShowcase[]
  playerOfTheWeek    PlayerOfTheWeek[]
  contentSubmissions AthleteContentSubmission[]

  @@index([coachUserId, status])
  @@index([athleteProfileId, status])
  @@index([trainingVideoId])
  @@index([submittedAt])
  @@index([purpose])
  @@index([showcaseVisibility])
}

/**
 * Synchronized coach commentary for one VideoReview.
 * timelineJson is a validated ordered event array because playback reads the
 * whole timeline sequentially; individual events are not queried independently.
 */
model VoiceReview {
  id               String      @id @default(cuid())
  videoReviewId    String      @unique
  videoReview      VideoReview @relation(fields: [videoReviewId], references: [id], onDelete: Cascade)
  coachUserId      String
  coachUser        User        @relation("VoiceReviewCoach", fields: [coachUserId], references: [id], onDelete: Cascade)
  audioStorageKey  String
  storageProvider  String
  audioMimeType    String
  durationMs       Int
  timelineJson     Json
  /**
   * READY | FAILED
   */
  status           String      @default("READY")
  /**
   * Future transcription fields; not populated yet
   */
  transcriptText   String?
  transcriptStatus String?
  createdAt        DateTime    @default(now())
  completedAt      DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([coachUserId])
  @@index([status])
}

/**
 * Links a video review to training assigned from that review (TrainingPlan).
 */
model VideoReviewTrainingLink {
  id                   String       @id @default(cuid())
  videoReviewId        String
  videoReview          VideoReview  @relation(fields: [videoReviewId], references: [id], onDelete: Cascade)
  trainingPlanId       String
  trainingPlan         TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  /**
   * DRILL | WORKOUT | PROGRAM
   */
  assignmentKind       String       @default("DRILL")
  coachNote            String?
  /**
   * Future: COACH | AI_SUGGESTED | AI_APPROVED
   */
  recommendationSource String       @default("COACH")
  assignedByUserId     String
  assignedByUser       User         @relation("VideoReviewTrainingAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())

  @@index([videoReviewId])
  @@index([trainingPlanId])
}

/**
 * Extensible in-app notification feed.
 */
model AppNotification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * VIDEO_SUBMITTED | VIDEO_REVIEWED | VIDEO_TRAINING_ASSIGNED | ...
   */
  type        String
  title       String
  body        String?
  href        String?
  /**
   * Opaque related entity id (e.g. videoReviewId)
   */
  entityId    String?
  entityType  String?
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
}

model ProgressGoal {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  label       String
  targetValue Float
  unit        String
  direction   String    @default("HIGHER")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([athleteId])
}

model ParentShareLink {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  token       String    @unique
  label       String?
  parentEmail String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([athleteId])
  @@index([token])
}

model ProgressMetric {
  id          String       @id @default(cuid())
  athleteId   String
  athlete     Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  label       String
  value       Float
  unit        String
  recordedAt  DateTime     @default(now())
  notes       String?
  createdAt   DateTime     @default(now())
  metricEntry MetricEntry? @relation("LegacyMetricEntry")

  @@index([athleteId])
  @@index([athleteId, label])
}

model TrainingPlan {
  id               String                    @id @default(cuid())
  coachId          String
  coach            User                      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId        String?
  athlete          Athlete?                  @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           String                    @default("ACTIVE")
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  workouts         Workout[]
  videoReviewLinks VideoReviewTrainingLink[]

  @@index([coachId])
  @@index([athleteId])
}

model Workout {
  id                         String            @id @default(cuid())
  trainingPlanId             String
  trainingPlan               TrainingPlan      @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  title                      String
  description                String?
  scheduledDate              DateTime?
  durationMinutes            Int?
  completed                  Boolean           @default(false)
  completedAt                DateTime?
  sortOrder                  Int               @default(0)
  /**
   * Demo / how-to clip kids and parents can watch (share link + coach portal)
   */
  instructionVideoUrl        String?
  instructionVideoStorageKey String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  exercises                  WorkoutExercise[]
  sessions                   WorkoutSession[]

  @@index([trainingPlanId])
}

/**
 * Prescription line inside a workout (reusable structure, assigned with the plan).
 */
model WorkoutExercise {
  id                 String            @id @default(cuid())
  workoutId          String
  workout            Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name               String
  instructions       String?
  coachingCue        String?
  videoUrl           String?
  sets               Int?
  reps               Int?
  durationSec        Int?
  restSec            Int?
  equipment          String?
  sortOrder          Int               @default(0)
  resultRequired     Boolean           @default(false)
  /**
   * NUMBER | RATIO | COUNT | TIME | WEIGHT | NONE
   */
  resultKind         String            @default("NONE")
  resultUnit         String?
  metricDefinitionId String?
  metricDefinition   MetricDefinition? @relation(fields: [metricDefinitionId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  results            ExerciseResult[]

  @@index([workoutId])
  @@index([metricDefinitionId])
}

/**
 * One athlete's attempt at a prescribed workout.
 */
model WorkoutSession {
  id              String           @id @default(cuid())
  workoutId       String
  workout         Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  athleteId       String
  athlete         Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  /**
   * Logged-in athlete user when they run the session
   */
  athleteUserId   String?
  athleteUser     User?            @relation("WorkoutSessionAthleteUser", fields: [athleteUserId], references: [id], onDelete: SetNull)
  /**
   * NOT_STARTED | IN_PROGRESS | COMPLETED
   */
  status          String           @default("IN_PROGRESS")
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  durationMinutes Int?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  results         ExerciseResult[]

  @@index([workoutId])
  @@index([athleteId])
  @@index([athleteUserId])
  @@index([status])
}

/**
 * Per-exercise completion + flexible result payload.
 */
model ExerciseResult {
  id                String          @id @default(cuid())
  sessionId         String
  session           WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  completed         Boolean         @default(true)
  completedAt       DateTime        @default(now())
  /**
   * NUMBER | RATIO | COUNT | TIME | WEIGHT | NONE
   */
  resultKind        String          @default("NONE")
  valuePrimary      Float?
  valueSecondary    Float?
  valueText         String?
  unit              String?
  notes             String?
  metricEntryId     String?         @unique
  metricEntry       MetricEntry?    @relation(fields: [metricEntryId], references: [id], onDelete: SetNull)
  isPersonalRecord  Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([sessionId, workoutExerciseId])
  @@index([sessionId])
  @@index([workoutExerciseId])
}

/**
 * Coach invites an athlete to create their own login linked to AthleteProfile.
 */
model AthleteInvite {
  id              String    @id @default(cuid())
  athleteId       String
  athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  email           String
  tokenHash       String    @unique
  invitedByUserId String
  invitedBy       User      @relation("AthleteInviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([athleteId])
  @@index([email])
  @@index([invitedByUserId])
}

model Course {
  id                String       @id @default(cuid())
  coachId           String
  coach             User         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sport             String
  title             String
  description       String?
  ageBand           String?
  published         Boolean      @default(true)
  /**
   * COACH = private coach library. PLATFORM = Train2Play master sport catalog.
   */
  origin            String       @default("COACH")
  shareWithCoaches  Boolean      @default(false)
  shareWithAthletes Boolean      @default(false)
  /**
   * If this row was copied from a platform course, that source id.
   */
  sourceCourseId    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  items             CourseItem[]

  @@index([coachId])
  @@index([coachId, sport])
  @@index([origin, sport])
  @@index([shareWithCoaches, sport])
  @@index([shareWithAthletes, sport])
  @@index([coachId, sourceCourseId])
}

model CourseItem {
  id              String               @id @default(cuid())
  courseId        String
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type            String               @default("DRILL")
  title           String
  body            String?
  focus           String?
  coachingCue     String?
  equipment       String?
  durationMin     Int?
  ageBand         String?
  videoUrl        String?
  videoStorageKey String?
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  athleteProgress CourseItemProgress[]

  @@index([courseId])
}

/**
 * Athlete engagement with one published library item. Powers director health metrics.
 */
model CourseItemProgress {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  courseItemId     String
  courseItem       CourseItem     @relation(fields: [courseItemId], references: [id], onDelete: Cascade)
  viewedAt         DateTime?
  completedAt      DateTime?
  viewCount        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([athleteProfileId, courseItemId])
  @@index([athleteProfileId, completedAt])
  @@index([courseItemId, viewedAt])
}

/**
 * Train2Play-wide suggested drills, edited by trainers.
 */
model CatalogDrill {
  id                String                         @id @default(cuid())
  sport             String
  ageBand           String
  title             String
  focus             String
  durationMin       Int
  equipment         String
  howTo             String
  coachingCue       String
  videoUrl          String?
  videoStorageKey   String?
  shareWithCoaches  Boolean                        @default(true)
  shareWithAthletes Boolean                        @default(true)
  /**
   * NONE | ALL_SPORT | SELECTED
   */
  athleteAudience   String                         @default("ALL_SPORT")
  athleteRecipients CatalogDrillAthleteRecipient[]
  pushes            CatalogDrillPush[]
  sortOrder         Int                            @default(0)
  isActive          Boolean                        @default(true)
  updatedById       String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@index([sport, ageBand, isActive])
}

/**
 * Named-player delivery for a suggested drill when athleteAudience = SELECTED.
 */
model CatalogDrillAthleteRecipient {
  id               String         @id @default(cuid())
  catalogDrillId   String
  catalogDrill     CatalogDrill   @relation(fields: [catalogDrillId], references: [id], onDelete: Cascade)
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([catalogDrillId, athleteProfileId])
  @@index([athleteProfileId])
}

/**
 * One real send of a suggested drill to one player, by the director or by a coach.
 */
model CatalogDrillPush {
  id               String         @id @default(cuid())
  catalogDrillId   String
  catalogDrill     CatalogDrill   @relation(fields: [catalogDrillId], references: [id], onDelete: Cascade)
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  /**
   * DIRECTOR | COACH
   */
  source           String         @default("DIRECTOR")
  pushedByUserId   String
  pushedBy         User           @relation("CatalogDrillPushSender", fields: [pushedByUserId], references: [id], onDelete: Cascade)
  note             String?
  firstViewedAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([catalogDrillId, athleteProfileId, pushedByUserId])
  @@index([catalogDrillId, source])
  @@index([athleteProfileId])
  @@index([pushedByUserId])
}

/**
 * Explicit opt-in for a video to appear on the shareable Player Profile.
 * Coaching film is never public unless the athlete adds it here.
 */
model AthleteProfileVideoShowcase {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  videoReviewId    String
  videoReview      VideoReview    @relation(fields: [videoReviewId], references: [id], onDelete: Cascade)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([athleteProfileId, videoReviewId])
  @@index([athleteProfileId, sortOrder])
  @@index([videoReviewId])
}

/**
 * Athlete submits an existing VideoReview to the Train2Play admin content queue.
 * Does not copy the file — Admin receives the same video + live Player Profile data.
 */
model AthleteContentSubmission {
  id                      String          @id @default(cuid())
  athleteProfileId        String
  athleteProfile          AthleteProfile  @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  videoReviewId           String
  videoReview             VideoReview     @relation(fields: [videoReviewId], references: [id], onDelete: Cascade)
  category                String
  note                    String?
  featurePermission       Boolean         @default(false)
  socialMediaPermission   Boolean         @default(false)
  guardianApproved        Boolean         @default(false)
  status                  String          @default("PENDING")
  metricEntryId           String?
  metricEntry             MetricEntry?    @relation(fields: [metricEntryId], references: [id], onDelete: SetNull)
  adminNote               String?
  reviewedAt              DateTime?
  reviewedByUserId        String?
  reviewedByUser          User?           @relation("ContentSubmissionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([athleteProfileId])
  @@index([videoReviewId])
}

model AthleteAchievement {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  key              String
  occurrenceKey    String
  title            String
  description      String?
  earnedAt         DateTime       @default(now())
  shareable        Boolean        @default(true)
  metadataJson     String?
  createdAt        DateTime       @default(now())
  videoReviews     VideoReview[]

  @@unique([athleteProfileId, occurrenceKey])
  @@index([athleteProfileId, earnedAt])
  @@index([key])
}

model PlayerOfTheWeek {
  id                    String           @id @default(cuid())
  athleteProfileId      String
  athleteProfile        AthleteProfile   @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  sport                 String?
  featuredVideoReviewId String?
  featuredVideoReview   VideoReview?     @relation(fields: [featuredVideoReviewId], references: [id], onDelete: SetNull)
  highlight             String?
  description           String
  startDate             DateTime
  endDate               DateTime
  published             Boolean          @default(false)
  publishedAt           DateTime?
  createdByUserId       String
  createdByUser         User             @relation("PlayerOfTheWeekCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  homepageModules       HomepageModule[]

  @@index([published, startDate, endDate])
  @@index([athleteProfileId])
}

model Challenge {
  id                 String               @id @default(cuid())
  name               String
  description        String
  sport              String?
  scoringType        ChallengeScoringType
  targetValue        Int?
  metricDefinitionId String?
  workoutTitle       String?
  catalogDrillId     String?
  startAt            DateTime
  endAt              DateTime
  status             ChallengeStatus      @default(DRAFT)
  rewardBadgeKey     String               @default("CHALLENGE_COMPLETE")
  createdByUserId    String
  createdByUser      User                 @relation("ChallengeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  entries            ChallengeEntry[]
  homepageModules    HomepageModule[]

  @@index([status, startAt, endAt])
  @@index([sport, status])
}

model ChallengeEntry {
  id               String         @id @default(cuid())
  challengeId      String
  challenge        Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  progressValue    Float          @default(0)
  completedAt      DateTime?
  winner           Boolean        @default(false)
  updatedAt        DateTime       @updatedAt
  createdAt        DateTime       @default(now())

  @@unique([challengeId, athleteProfileId])
  @@index([challengeId, progressValue])
  @@index([athleteProfileId])
}

/**
 * Command-center editorial pack for the public homepage each week.
 */
model HomepageWeek {
  id              String           @id @default(cuid())
  weekOf          DateTime
  headline        String?
  published       Boolean          @default(false)
  publishedAt     DateTime?
  createdByUserId String
  createdByUser   User             @relation("HomepageWeekCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  modules         HomepageModule[]

  @@unique([weekOf])
  @@index([published, weekOf])
}

model HomepageModule {
  id                 String             @id @default(cuid())
  weekId             String
  week               HomepageWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  slot               Int
  kind               HomepageModuleKind
  published          Boolean            @default(true)
  title              String?
  subtitle           String?
  body               String?
  playerOfTheWeekId  String?
  playerOfTheWeek    PlayerOfTheWeek?   @relation(fields: [playerOfTheWeekId], references: [id], onDelete: SetNull)
  challengeId        String?
  challenge          Challenge?         @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  metricDefinitionId String?
  sport              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([weekId, slot])
  @@index([weekId, published, slot])
}

/**
 * Future competition (GameChanger, etc.) stays separate from training metrics.
 * No importer in V1 — schema only so recruiting/profile can grow in place.
 */
model CompetitionStat {
  id               String         @id @default(cuid())
  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  source           String         @default("MANUAL")
  season           String?
  statKey          String
  statLabel        String
  statValue        Float
  unit             String?
  recordedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  @@index([athleteProfileId, season])
}

/**
 * Professional Coach Profile. A Coach account does NOT automatically create
 * a public/discoverable profile — discoveryStatus must be APPROVED by Admin.
 */
model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("CoachProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  publicSlug    String?   @unique
  slugUpdatedAt DateTime?
  displayName   String?
  bio           String?
  avatarUrl     String?
  coverImageUrl String?

  organizationName String?
  locationLabel    String?
  locationCity     String?
  locationState    String?
  serviceArea      String?

  yearsCoaching   Int?
  experienceText  String?
  certifications  String?

  inPersonCoaching Boolean @default(true)
  remoteCoaching   Boolean @default(false)
  acceptingAthletes Boolean @default(false)
  /**
   * Coach toggle. Server still requires discoveryStatus = APPROVED to appear in Find a Coach.
   */
  appearInFindACoach Boolean @default(true)
  maxActiveAthletes  Int?

  featuredVideoId     String?
  featuredVideo       TrainingVideo? @relation("CoachFeaturedVideo", fields: [featuredVideoId], references: [id], onDelete: SetNull)
  featuredVideoPublic Boolean        @default(false)

  websiteUrl       String?
  websitePublic    Boolean @default(true)
  instagramHandle  String?
  instagramUrl     String?
  instagramPublic  Boolean @default(true)
  xHandle          String?
  xUrl             String?
  xPublic          Boolean @default(true)
  tiktokHandle     String?
  tiktokUrl        String?
  tiktokPublic     Boolean @default(true)
  youtubeHandle    String?
  youtubeUrl       String?
  youtubePublic    Boolean @default(true)

  /**
   * DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | DECLINED | SUSPENDED | REREVIEW
   */
  discoveryStatus     String    @default("DRAFT")
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedByUserId    String?
  reviewedByUser      User?     @relation("CoachProfileReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  adminNote           String?
  declineReason       String?
  requestChangesNote  String?
  train2playApprovedAt DateTime?

  /**
   * NOT_REQUIRED | NOT_STARTED | PENDING | CLEAR | REVIEW_REQUIRED | EXPIRED | UNAVAILABLE
   * Status metadata only — never a fabricated background-check result.
   */
  backgroundCheckStatus      String    @default("NOT_STARTED")
  backgroundCheckProvider    String?
  backgroundCheckRequestedAt DateTime?
  backgroundCheckCompletedAt DateTime?
  backgroundCheckExpiresAt   DateTime?
  backgroundCheckReference   String?
  backgroundCheckAdminNote   String?

  /**
   * Reserved for a future marketplace. Unused in this release.
   */
  marketplaceJson String?
  /**
   * Reserved for future athlete/guardian reviews. Unused in this release.
   */
  reviewsJson     String?

  sports CoachProfileSport[]
  videos CoachProfileVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discoveryStatus, appearInFindACoach, acceptingAthletes])
  @@index([locationState])
  @@index([publicSlug])
  @@index([reviewedByUserId])
}

model CoachProfileSport {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  sport          String
  isPrimary      Boolean      @default(false)
  specialties    String[]     @default([])
  positions      String[]     @default([])
  ageGroups      String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([coachProfileId, sport])
  @@index([sport])
  @@index([coachProfileId])
}

/**
 * Showcase clip on a Coach Profile. Reuses TrainingVideo — no second media store.
 */
model CoachProfileVideo {
  id              String        @id @default(cuid())
  coachProfileId  String
  coachProfile    CoachProfile  @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  trainingVideoId String
  trainingVideo   TrainingVideo @relation(fields: [trainingVideoId], references: [id], onDelete: Cascade)
  /**
   * TRAINING | DRILL | INTRODUCTION
   */
  kind            String        @default("TRAINING")
  title           String?
  publicEligible  Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([coachProfileId, trainingVideoId])
  @@index([coachProfileId, publicEligible, sortOrder])
}

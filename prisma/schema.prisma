generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String         @id @default(cuid())
  name                   String
  email                  String         @unique
  passwordHash           String
  role                   String         @default("COACH")
  zipCode                String?
  latitude               Float?
  longitude              Float?
  searchRadiusMiles      Int            @default(25)
  pickupAlertsEnabled    Boolean        @default(true)
  lookingForSport        String?
  lookingForPositions    String?
  minThrowingVelo        Float?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  athletes             Athlete[]
  trainingPlans        TrainingPlan[]
  trainingVideos       TrainingVideo[]
  pickupInterests      PickupInterest[]
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Athlete {
  id            String         @id @default(cuid())
  coachId       String
  coach         User           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  sport         String
  position      String?
  notes         String?
  rosterStatus  String         @default("ROSTER")
  throws        String?
  bats          String?
  zipCode       String?
  latitude      Float?
  longitude     Float?
  pickupType    String?
  availabilityNotes String?
  listedForPickup   Boolean      @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  trainingPlans TrainingPlan[]
  progressMetrics ProgressMetric[]
  progressGoals   ProgressGoal[]
  shareLinks      ParentShareLink[]
  trainingVideos  TrainingVideo[]
  pickupInterests PickupInterest[]

  @@index([coachId])
  @@index([rosterStatus, listedForPickup])
}

model PickupInterest {
  id                 String   @id @default(cuid())
  interestedCoachId  String
  interestedCoach    User     @relation(fields: [interestedCoachId], references: [id], onDelete: Cascade)
  pickupAthleteId    String
  pickupAthlete      Athlete  @relation(fields: [pickupAthleteId], references: [id], onDelete: Cascade)
  message            String?
  createdAt          DateTime @default(now())

  @@unique([interestedCoachId, pickupAthleteId])
  @@index([pickupAthleteId])
}

model TrainingVideo {
  id          String            @id @default(cuid())
  coachId     String
  coach       User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId   String?
  athlete     Athlete?          @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  title       String
  description String?
  sourceType  String            @default("URL")
  videoUrl    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  annotations VideoAnnotation[]

  @@index([coachId])
  @@index([athleteId])
}

model VideoAnnotation {
  id          String        @id @default(cuid())
  videoId     String
  video       TrainingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  timestampMs Int
  label       String?
  note        String?
  strokes     String
  createdAt   DateTime      @default(now())

  @@index([videoId])
  @@index([videoId, timestampMs])
}

model ProgressGoal {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  label       String
  targetValue Float
  unit        String
  direction   String    @default("HIGHER")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([athleteId])
}

model ParentShareLink {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  token       String    @unique
  label       String?
  parentEmail String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([athleteId])
  @@index([token])
}

model ProgressMetric {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  label      String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([athleteId])
  @@index([athleteId, label])
}

model TrainingPlan {
  id          String    @id @default(cuid())
  coachId     String
  coach       User      @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId   String?
  athlete     Athlete?  @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workouts    Workout[]

  @@index([coachId])
  @@index([athleteId])
}

model Workout {
  id              String       @id @default(cuid())
  trainingPlanId  String
  trainingPlan    TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  scheduledDate   DateTime?
  durationMinutes Int?
  completed       Boolean      @default(false)
  completedAt     DateTime?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([trainingPlanId])
}

# Copy this file to .env and fill in values for local development.

# PostgreSQL — start local DB with: docker compose up -d
DATABASE_URL="postgresql://train2play:train2play@localhost:5432/train2play"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:43123"
NEXT_PUBLIC_APP_URL="http://localhost:43123"

# Optional: load demo accounts (coach@example.com / password123)
# Skipped automatically in production unless SEED_DEMO=true
# SEED_DEMO="true"

# Optional: automated emails via Resend (https://resend.com)
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Train2Play <noreply@train2play.com>"

# Optional: cloud video storage (Cloudflare R2 or AWS S3)
# Without these, uploads save to public/uploads/ (fine for local dev only)
# S3_BUCKET="train2play-videos"
# S3_REGION="auto"
# S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
# S3_PUBLIC_URL="https://videos.train2play.com"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

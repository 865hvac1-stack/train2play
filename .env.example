# Copy this file to .env and fill in values for local development.

# PostgreSQL — start local DB with: docker compose up -d
DATABASE_URL="postgresql://train2play:train2play@localhost:5432/train2play"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:43123"
NEXT_PUBLIC_APP_URL="http://localhost:43123"

# Optional: load demo accounts (coach@example.com / password123) via npm run db:seed
# Never set SEED_DEMO=true on the public production site
# SEED_DEMO="true"

# Email (Resend) — required for password reset, pickup alerts, parent invites
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Train2Play <noreply@train2play.com>"

# Your login becomes the Train2Play master-library admin (comma-separated ok)
# PLATFORM_ADMIN_EMAIL="you@train2play.com"
# TRAINER_EMAILS="chase@train2play.com"

# Video uploads (easiest) — free Cloudinary account, one variable:
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Or separately:
# CLOUDINARY_CLOUD_NAME="..."
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."

# Cloudflare R2 — recommended for private, direct, chunked long-video uploads.
# Keep the bucket private; do NOT set S3_PUBLIC_URL.
# S3_BUCKET="train2play-videos"
# S3_REGION="auto"
# S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
